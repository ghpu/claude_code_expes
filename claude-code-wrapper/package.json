{
  "name": "claude-code-wrapper",
  "version": "1.0.0",
  "description": "Dual-instance Claude Code wrapper with Manager/Critique and Worker pattern",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "claude-wrapper": "dist/cli-real.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "ts-node src/cli-real.ts",
    "dev:mock": "ts-node src/cli.ts",
    "start": "node dist/cli-real.js",
    "start:mock": "node dist/cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "claude",
    "claude-code",
    "code-generation",
    "ai",
    "code-quality",
    "project-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@types/glob": "^8.1.0",
    "glob": "^11.0.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
